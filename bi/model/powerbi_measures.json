[
  { "name": "SKUs Ativos", "expression": "CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE())", "folder": "1. Estoque", "format": "0" },
  { "name": "SKUs com Saldo", "expression": "CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[estoque_atual] > 0)", "folder": "1. Estoque", "format": "0" },
  { "name": "SKUs Empenhados", "expression": "CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[empenhado_total] > 0)", "folder": "1. Estoque", "format": "0" },
  { "name": "SKUs com Disponível", "expression": "CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[estoque_disponivel] > 0)", "folder": "1. Estoque", "format": "0" },
  { "name": "SKUs Zerados", "expression": "CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[status_estoque] = \"ZERADO\")", "folder": "1. Estoque", "format": "0" },
  { "name": "SKUs em Risco Estoque", "expression": "CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[status_estoque] IN {\"BAIXO\", \"SALDO_COMPROMETIDO\"})", "folder": "1. Estoque", "format": "0" },
  { "name": "% SKUs com Saldo", "expression": "DIVIDE([SKUs com Saldo], [SKUs Ativos])", "folder": "1. Estoque", "format": "0.0%" },
  { "name": "Estoque Atual (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_estoque_atual[estoque_atual]))", "folder": "1. Estoque\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Empenhado Total (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_estoque_atual[empenhado_total]))", "folder": "1. Estoque\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Estoque Disponível (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_estoque_atual[estoque_disponivel]))", "folder": "1. Estoque\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Entradas (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), CALCULATE(SUM(fato_movimentacoes_estoque[quantidade]), fato_movimentacoes_estoque[tipo] = \"ENTRADA\", fato_movimentacoes_estoque[movement_status] = \"ATIVA\"))", "folder": "1. Estoque\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Consumo (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), ABS(CALCULATE(SUM(fato_movimentacoes_estoque[quantidade]), fato_movimentacoes_estoque[tipo] = \"BAIXA\", fato_movimentacoes_estoque[movement_status] = \"ATIVA\")))", "folder": "1. Estoque\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Movimentações Ativas", "expression": "CALCULATE(COUNTROWS(fato_movimentacoes_estoque), fato_movimentacoes_estoque[movement_status] = \"ATIVA\")", "folder": "1. Estoque", "format": "0" },
  { "name": "Baixas Registradas", "expression": "CALCULATE(COUNTROWS(fato_movimentacoes_estoque), fato_movimentacoes_estoque[movement_status] = \"ATIVA\", fato_movimentacoes_estoque[tipo] = \"BAIXA\")", "folder": "1. Estoque", "format": "0" },
  { "name": "Status Estoque Ação", "expression": "VAR _ativo = SELECTEDVALUE(fato_estoque_atual[sku_ativo]) VAR _status = SELECTEDVALUE(fato_estoque_atual[status_estoque]) RETURN IF(NOT _ativo || _status = \"OK\", BLANK(), SWITCH(_status, \"ZERADO\", \"REPOR — ZERADO\", \"SALDO_COMPROMETIDO\", \"CRÍTICO — COMPROMETIDO\", \"BAIXO\", \"REPOR — ABAIXO DO MÍNIMO\", _status))", "folder": "1. Estoque\\Ações", "format": "" },

  { "name": "O.S. no WIP", "expression": "CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[em_wip] = TRUE())", "folder": "2. PCP", "format": "0" },
  { "name": "O.S. em Produção", "expression": "CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[fase_wip] = \"PRODUCAO\")", "folder": "2. PCP", "format": "0" },
  { "name": "O.S. Atrasadas", "expression": "CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[entrega_atrasada] = TRUE())", "folder": "2. PCP", "format": "0" },
  { "name": "% O.S. Atrasadas", "expression": "DIVIDE([O.S. Atrasadas], [O.S. no WIP])", "folder": "2. PCP", "format": "0.0%" },
  { "name": "Avanço Médio %", "expression": "AVERAGEX(FILTER(dim_ordem_servico, dim_ordem_servico[em_wip] = TRUE()), dim_ordem_servico[percentual_avanco]) / 100", "folder": "2. PCP", "format": "0.0%" },
  { "name": "Mediana Dias no WIP", "expression": "MEDIANX(FILTER(dim_ordem_servico, dim_ordem_servico[em_wip] = TRUE()), dim_ordem_servico[dias_no_wip])", "folder": "2. PCP", "format": "0" },
  { "name": "O.S. com Material Pendente", "expression": "CALCULATE(DISTINCTCOUNT(fato_necessidades_os[work_order_id]), fato_necessidades_os[quantidade_pendente] > 0)", "folder": "2. PCP", "format": "0" },
  { "name": "O.S. com Estrutura", "expression": "DISTINCTCOUNT(fato_necessidades_os[work_order_id])", "folder": "2. PCP", "format": "0" },
  { "name": "O.S. Totalmente Cobertas", "expression": "COUNTROWS(FILTER(VALUES(fato_necessidades_os[work_order_id]), CALCULATE(SUM(fato_necessidades_os[quantidade_pendente])) = 0))", "folder": "2. PCP", "format": "0" },
  { "name": "% O.S. Cobertas", "expression": "DIVIDE([O.S. Totalmente Cobertas], [O.S. com Estrutura])", "folder": "2. PCP", "format": "0.0%" },
  { "name": "Linhas Material Pendente O.S.", "expression": "CALCULATE(COUNTROWS(fato_necessidades_os), fato_necessidades_os[quantidade_pendente] > 0)", "folder": "2. PCP\\Ações", "format": "0" },
  { "name": "Dias para Entrega O.S.", "expression": "VAR _data = MIN(dim_ordem_servico[data_entrega_vigente]) RETURN IF(NOT ISBLANK(_data), DATEDIFF(TODAY(), _data, DAY))", "folder": "2. PCP\\Ações", "format": "0" },
  { "name": "Risco O.S.", "expression": "VAR _wip = SELECTEDVALUE(dim_ordem_servico[em_wip], FALSE()) VAR _atrasada = SELECTEDVALUE(dim_ordem_servico[entrega_atrasada], FALSE()) VAR _pendente = [Linhas Material Pendente O.S.] RETURN IF(NOT _wip, BLANK(), SWITCH(TRUE(), _atrasada && _pendente > 0, \"CRÍTICO — ATRASO + MATERIAL\", _atrasada, \"CRÍTICO — PRAZO\", _pendente > 0, \"ATENÇÃO — MATERIAL\", \"MONITORAR\"))", "folder": "2. PCP\\Ações", "format": "" },
  { "name": "Forecasts Ativos", "expression": "CALCULATE(DISTINCTCOUNT(fato_forecast[forecast_id]), fato_forecast[status] = \"ATIVO\")", "folder": "2. PCP", "format": "0" },

  { "name": "Linhas em Trânsito", "expression": "CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE())", "folder": "3. Compras", "format": "0" },
  { "name": "Valor em Trânsito", "expression": "CALCULATE(SUM(fato_compras_transito[valor_pendente]), fato_compras_transito[em_transito] = TRUE())", "folder": "3. Compras", "format": "R$ #,0.00" },
  { "name": "Linhas Atrasadas", "expression": "CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE(), FILTER(fato_compras_transito, NOT ISBLANK(fato_compras_transito[data_necessidade]) && fato_compras_transito[data_necessidade] >= DATE(2000, 1, 1) && fato_compras_transito[data_necessidade] < TODAY()))", "folder": "3. Compras", "format": "0" },
  { "name": "% Linhas Atrasadas", "expression": "DIVIDE([Linhas Atrasadas], [Linhas em Trânsito])", "folder": "3. Compras", "format": "0.0%" },
  { "name": "Linhas sem Data", "expression": "CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE(), fato_compras_transito[situacao_transito] = \"SEM DATA\")", "folder": "3. Compras", "format": "0" },
  { "name": "Linhas Data Inválida", "expression": "CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE(), fato_compras_transito[dias_para_remessa] < -3650)", "folder": "3. Compras", "format": "0" },
  { "name": "O.C. Abertas", "expression": "CALCULATE(DISTINCTCOUNT(fato_compras_transito[purchase_order_id]), fato_compras_transito[em_transito] = TRUE())", "folder": "3. Compras", "format": "0" },
  { "name": "O.C. Atrasadas", "expression": "CALCULATE(DISTINCTCOUNT(fato_compras_transito[purchase_order_id]), fato_compras_transito[em_transito] = TRUE(), FILTER(fato_compras_transito, NOT ISBLANK(fato_compras_transito[data_necessidade]) && fato_compras_transito[data_necessidade] >= DATE(2000, 1, 1) && fato_compras_transito[data_necessidade] < TODAY()))", "folder": "3. Compras", "format": "0" },
  { "name": "Recebimentos Confirmados", "expression": "CALCULATE(COUNTROWS(fato_recebimentos_inspecao), fato_recebimentos_inspecao[status_recebimento] = \"CONFIRMADO\")", "folder": "3. Compras", "format": "0" },
  { "name": "Taxa Aprovação Média %", "expression": "AVERAGEX(FILTER(fato_recebimentos_inspecao, fato_recebimentos_inspecao[status_recebimento] = \"CONFIRMADO\" && fato_recebimentos_inspecao[quantidade_fisica] > 0), DIVIDE(fato_recebimentos_inspecao[quantidade_aprovada], fato_recebimentos_inspecao[quantidade_fisica]))", "folder": "3. Compras", "format": "0.0%" },
  { "name": "Ação Compra", "expression": "VAR _transito = SELECTEDVALUE(fato_compras_transito[em_transito], FALSE()) VAR _data = SELECTEDVALUE(fato_compras_transito[data_necessidade]) VAR _dias = SELECTEDVALUE(fato_compras_transito[dias_para_remessa]) RETURN IF(NOT _transito, BLANK(), SWITCH(TRUE(), _dias < -3650, \"VALIDAR DATA — INVÁLIDA\", ISBLANK(_data), \"DEFINIR DATA\", _data < TODAY(), \"COBRAR — ATRASADA\", BLANK()))", "folder": "3. Compras\\Ações", "format": "" },
  { "name": "Dias para Remessa Válido", "expression": "VAR _dias = SELECTEDVALUE(fato_compras_transito[dias_para_remessa]) RETURN IF(NOT ISBLANK(_dias) && _dias >= -3650, _dias)", "folder": "3. Compras\\Ações", "format": "0" },
  { "name": "Valor Linha em Trânsito", "expression": "IF(SELECTEDVALUE(fato_compras_transito[em_transito], FALSE()), SUM(fato_compras_transito[valor_pendente]))", "folder": "3. Compras\\Ações", "format": "R$ #,0.00" },

  { "name": "SKUs com Demanda", "expression": "CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[necessidade_total] > 0)", "folder": "4. MRP", "format": "0" },
  { "name": "SKUs MRP em Demanda", "expression": "CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[necessidade_total] > 0)", "folder": "4. MRP", "format": "0" },
  { "name": "SKUs Cobertos", "expression": "CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[necessidade_total] > 0, fato_mrp[status_mrp] = \"COBERTO\")", "folder": "4. MRP", "format": "0" },
  { "name": "SKUs a Comprar", "expression": "CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[status_mrp] = \"COMPRAR\")", "folder": "4. MRP", "format": "0" },
  { "name": "% SKUs MRP Cobertos", "expression": "DIVIDE([SKUs Cobertos], [SKUs com Demanda])", "folder": "4. MRP", "format": "0.0%" },
  { "name": "Forecasts sem Estrutura", "expression": "CALCULATE(DISTINCTCOUNT(fato_forecast[forecast_id]), fato_forecast[status] = \"ATIVO\", fato_forecast[possui_estrutura_materiais] = FALSE())", "folder": "4. MRP", "format": "0" },
  { "name": "Próxima Necessidade", "expression": "CALCULATE(MIN(fato_necessidades_os[data_entrega_vigente]), fato_necessidades_os[quantidade_pendente] > 0)", "folder": "4. MRP\\Ações", "format": "dd/MM/yyyy" },
  { "name": "Dias até Próxima Necessidade", "expression": "VAR _data = [Próxima Necessidade] RETURN IF(NOT ISBLANK(_data), DATEDIFF(TODAY(), _data, DAY))", "folder": "4. MRP\\Ações", "format": "0" },
  { "name": "Prioridade MRP", "expression": "VAR _comprar = SELECTEDVALUE(fato_mrp[status_mrp]) = \"COMPRAR\" VAR _data = [Próxima Necessidade] RETURN IF(NOT _comprar, BLANK(), SWITCH(TRUE(), ISBLANK(_data), \"ATENÇÃO — SEM PRAZO\", _data <= TODAY(), \"CRÍTICO — VENCIDO/HOJE\", _data <= TODAY() + 7, \"URGENTE — PRÓXIMOS 7 DIAS\", \"ATENÇÃO — PROGRAMAR\"))", "folder": "4. MRP\\Ações", "format": "" },
  { "name": "Ordem Prioridade MRP", "expression": "SWITCH(TRUE(), LEFT([Prioridade MRP], 7) = \"CRÍTICO\", 1, LEFT([Prioridade MRP], 7) = \"URGENTE\", 2, LEFT([Prioridade MRP], 7) = \"ATENÇÃO\", 3)", "folder": "4. MRP\\Ações", "format": "0" },
  { "name": "SKUs Críticos", "expression": "COUNTROWS(FILTER(VALUES(dim_sku[sku_id]), VAR _data = CALCULATE(MIN(fato_necessidades_os[data_entrega_vigente]), fato_necessidades_os[quantidade_pendente] > 0) RETURN CALCULATE(MAX(fato_mrp[status_mrp])) = \"COMPRAR\" && NOT ISBLANK(_data) && _data <= TODAY()))", "folder": "4. MRP", "format": "0" },
  { "name": "SKUs Urgentes", "expression": "COUNTROWS(FILTER(VALUES(dim_sku[sku_id]), VAR _data = CALCULATE(MIN(fato_necessidades_os[data_entrega_vigente]), fato_necessidades_os[quantidade_pendente] > 0) RETURN CALCULATE(MAX(fato_mrp[status_mrp])) = \"COMPRAR\" && _data > TODAY() && _data <= TODAY() + 7))", "folder": "4. MRP", "format": "0" },
  { "name": "O.S. Impactadas por Compra", "expression": "VAR _skuComprar = CALCULATETABLE(VALUES(fato_mrp[sku_id]), fato_mrp[status_mrp] = \"COMPRAR\") RETURN CALCULATE(DISTINCTCOUNT(fato_necessidades_os[work_order_id]), fato_necessidades_os[quantidade_pendente] > 0, TREATAS(_skuComprar, fato_necessidades_os[sku_id]))", "folder": "4. MRP", "format": "0" },
  { "name": "O.S. Impactadas pelo SKU", "expression": "CALCULATE(DISTINCTCOUNT(fato_necessidades_os[work_order_id]), fato_necessidades_os[quantidade_pendente] > 0)", "folder": "4. MRP\\Ações", "format": "0" },
  { "name": "Necessidade Total (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[necessidade_total]))", "folder": "4. MRP\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Em Trânsito (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[quantidade_transito]))", "folder": "4. MRP\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Estoque Disponível MRP (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[estoque_disponivel]))", "folder": "4. MRP\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Necessidade Compra (U.M.)", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[necessidade_compra]))", "folder": "4. MRP\\Quantidades por U.M.", "format": "#,0.###" },
  { "name": "Última Atualização", "expression": "MAX(fato_mrp[atualizado_em])", "folder": "5. Auditoria", "format": "dd/MM/yyyy HH:mm" },

  { "name": "Estoque Atual", "expression": "[Estoque Atual (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Empenhado Total", "expression": "[Empenhado Total (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Estoque Disponivel", "expression": "[Estoque Disponível (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Entradas", "expression": "[Entradas (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Consumo", "expression": "[Consumo (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Necessidade Total", "expression": "[Necessidade Total (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Em Transito", "expression": "[Em Trânsito (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "MRP Estoque Disponivel", "expression": "[Estoque Disponível MRP (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Necessidade de Compra", "expression": "[Necessidade Compra (U.M.)]", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Necessidade de Compra c/ Minimo", "expression": "IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[necessidade_compra_com_estoque_minimo]))", "folder": "9. Compatibilidade\\Somente U.M. única", "format": "#,0.###" },
  { "name": "Avanco Medio %", "expression": "[Avanço Médio %]", "folder": "9. Compatibilidade", "format": "0.0%" },
  { "name": "O.S. em Producao", "expression": "[O.S. em Produção]", "folder": "9. Compatibilidade", "format": "0" },
  { "name": "Linhas em Transito", "expression": "[Linhas em Trânsito]", "folder": "9. Compatibilidade", "format": "0" },
  { "name": "Valor em Transito", "expression": "[Valor em Trânsito]", "folder": "9. Compatibilidade", "format": "R$ #,0.00" },
  { "name": "Taxa Aprovacao %", "expression": "[Taxa Aprovação Média %]", "folder": "9. Compatibilidade", "format": "0.0%" },
  { "name": "Ultima Atualizacao", "expression": "[Última Atualização]", "folder": "9. Compatibilidade", "format": "dd/MM/yyyy HH:mm" }
]
