/// View consultiva bi.fato_mrp no Supabase.
table fato_mrp
	lineageTag: a94a37cf-bee0-4788-bea4-b4c84d77e261

	measure 'SKUs com Saldo' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[estoque_atual] > 0)
		formatString: 0
		displayFolder: 1. Estoque
		lineageTag: 617c760c-484f-445f-aeb5-861f63f7c61b

	measure 'SKUs Empenhados' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[empenhado_total] > 0)
		formatString: 0
		displayFolder: 1. Estoque
		lineageTag: bfe0b2c6-b804-4900-8074-e8147b35a90c

	measure 'SKUs com Disponivel' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[estoque_disponivel] > 0)
		formatString: 0
		displayFolder: 1. Estoque
		lineageTag: 3c3e238b-9edd-495a-9978-c5ab295a8101

	measure 'SKUs Zerados' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[status_estoque] = "ZERADO")
		formatString: 0
		displayFolder: 1. Estoque
		lineageTag: daaa5ff3-1107-4a43-b903-6aa96593ab55

	measure 'SKUs Baixos' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[status_estoque] IN {"BAIXO", "SALDO_COMPROMETIDO"})
		formatString: 0
		displayFolder: 1. Estoque
		lineageTag: 5a960c47-5eca-4d5e-9b86-cabacc938bf8

	measure Entradas = CALCULATE(SUM(fato_movimentacoes_estoque[quantidade]), fato_movimentacoes_estoque[tipo] = "ENTRADA", fato_movimentacoes_estoque[movement_status] = "ATIVA")
		formatString: #,0.###
		displayFolder: 1. Estoque
		lineageTag: 83fcff56-043a-4d50-9e38-61eae0797c8f

	measure Consumo = ABS(CALCULATE(SUM(fato_movimentacoes_estoque[quantidade]), fato_movimentacoes_estoque[tipo] = "BAIXA", fato_movimentacoes_estoque[movement_status] = "ATIVA"))
		formatString: #,0.###
		displayFolder: 1. Estoque
		lineageTag: 530e9208-a15e-4034-9bc3-92209d6a86fa

	measure 'O.S. no WIP' = CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[em_wip] = TRUE())
		formatString: 0
		displayFolder: 2. PCP
		lineageTag: d72ae1f0-b300-4449-8b5e-f4d818df7943

	measure 'O.S. em Producao' = CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[fase_wip] = "PRODUCAO")
		formatString: 0
		displayFolder: 2. PCP
		lineageTag: 74a33760-9005-48a4-a287-c60087c42dba

	measure 'O.S. Atrasadas' = CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[entrega_atrasada] = TRUE())
		formatString: 0
		displayFolder: 2. PCP
		lineageTag: 61dfd7d7-d918-4a59-8ae8-20cc7e25e934

	measure 'Avanco Medio %' = AVERAGEX(FILTER(dim_ordem_servico, dim_ordem_servico[em_wip] = TRUE()), dim_ordem_servico[percentual_avanco]) / 100
		formatString: 0.0%
		displayFolder: 2. PCP
		lineageTag: 070edc1c-24c6-4e1b-8b52-2c1b0e7f25af

	measure 'O.S. com Material Pendente' = CALCULATE(DISTINCTCOUNT(fato_necessidades_os[work_order_id]), fato_necessidades_os[quantidade_pendente] > 0)
		formatString: 0
		displayFolder: 2. PCP
		lineageTag: 7a190459-9032-4f94-ba8d-efb6209e4896

	measure 'Linhas em Transito' = CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE())
		formatString: 0
		displayFolder: 3. Compras
		lineageTag: ed21e42b-cd3f-4a25-8a33-674ea80690ef

	measure 'Valor em Transito' = CALCULATE(SUM(fato_compras_transito[valor_pendente]), fato_compras_transito[em_transito] = TRUE())
		formatString: R$ #,0.00
		displayFolder: 3. Compras
		lineageTag: 302a3686-b513-4cd5-8c5e-ccc288d95f73

	measure 'Linhas Atrasadas' = CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE(), fato_compras_transito[situacao_transito] = "ATRASADA")
		formatString: 0
		displayFolder: 3. Compras
		lineageTag: 455ab5a4-3b06-446b-b231-6b1fcc60c5d6

	measure 'O.C. Abertas' = CALCULATE(DISTINCTCOUNT(fato_compras_transito[purchase_order_id]), fato_compras_transito[em_transito] = TRUE())
		formatString: 0
		displayFolder: 3. Compras
		lineageTag: 34f16aaf-799e-43b1-96d6-b88ebc6a864d

	measure 'Recebido Fisico' = CALCULATE(SUM(fato_recebimentos_inspecao[quantidade_fisica]), fato_recebimentos_inspecao[status_recebimento] = "CONFIRMADO")
		formatString: #,0.###
		displayFolder: 3. Compras
		lineageTag: a8abb69b-05a5-4230-9099-69fc8a85f0af

	measure 'Recebido Aprovado' = CALCULATE(SUM(fato_recebimentos_inspecao[quantidade_aprovada]), fato_recebimentos_inspecao[status_recebimento] = "CONFIRMADO")
		formatString: #,0.###
		displayFolder: 3. Compras
		lineageTag: d96a3767-f22b-464c-abbf-c65050ca9c5d

	measure 'Taxa Aprovacao %' = DIVIDE([Recebido Aprovado], [Recebido Fisico])
		formatString: 0.0%
		displayFolder: 3. Compras
		lineageTag: d2ff4735-494f-4584-9855-dc99626c19af

	measure 'SKUs com Demanda' = CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[necessidade_total] > 0)
		formatString: 0
		displayFolder: 4. MRP
		lineageTag: ad750727-22bb-436c-a213-aef7b00c1eaa

	measure 'SKUs Cobertos' = CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[status_mrp] = "COBERTO")
		formatString: 0
		displayFolder: 4. MRP
		lineageTag: 34010036-041e-4371-b567-27824964354a

	measure 'SKUs a Comprar' = CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[status_mrp] = "COMPRAR")
		formatString: 0
		displayFolder: 4. MRP
		lineageTag: c7f5d949-c50f-4d58-8add-e2d5d1d4c50c

	measure 'Forecasts sem Estrutura' = CALCULATE(DISTINCTCOUNT(fato_forecast[forecast_id]), fato_forecast[status] = "ATIVO", fato_forecast[possui_estrutura_materiais] = FALSE())
		formatString: 0
		displayFolder: 4. MRP
		lineageTag: 94879931-6e91-4ac7-8a24-ff69ce7c05fd

	measure 'Necessidade de Compra' = SUM(fato_mrp[necessidade_compra])
		formatString: #,0.###
		displayFolder: 4. MRP
		lineageTag: 529d94e6-d94a-4bed-aae8-20ad5cac6cf1

	measure 'Necessidade de Compra c/ Minimo' = SUM(fato_mrp[necessidade_compra_com_estoque_minimo])
		formatString: #,0.###
		displayFolder: 4. MRP
		lineageTag: 30375925-0c0f-42ec-b6f7-550e564b8c08

	measure 'Ultima Atualizacao' = MAX(fato_mrp[atualizado_em])
		formatString: dd/MM/yyyy HH:mm
		displayFolder: 4. MRP
		lineageTag: a8920888-724a-4cb8-a4a2-b96024f768fa

	measure 'Estoque Atual' = SUM(fato_estoque_atual[estoque_atual])
		formatString: #,0.###
		displayFolder: 1. Estoque

	measure 'Empenhado Total' = SUM(fato_estoque_atual[empenhado_total])
		formatString: #,0.###
		displayFolder: 1. Estoque

	measure 'Estoque Disponivel' = SUM(fato_estoque_atual[estoque_disponivel])
		formatString: #,0.###
		displayFolder: 1. Estoque

	measure 'Necessidade Total' = SUM(fato_mrp[necessidade_total])
		formatString: #,0.###
		displayFolder: 4. MRP

	measure 'Em Transito' = SUM(fato_mrp[quantidade_transito])
		formatString: #,0.###
		displayFolder: 4. MRP

	measure 'MRP Estoque Disponivel' = SUM(fato_mrp[estoque_disponivel])
		formatString: #,0.###
		displayFolder: 4. MRP

