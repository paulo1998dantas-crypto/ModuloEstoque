/// View consultiva bi.fato_mrp no Supabase.
table fato_mrp
	lineageTag: a94a37cf-bee0-4788-bea4-b4c84d77e261

	measure 'SKUs Ativos' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE())
		formatString: 0
		displayFolder: 1. Estoque

	measure 'SKUs com Saldo' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[estoque_atual] > 0)
		formatString: 0
		displayFolder: 1. Estoque

	measure 'SKUs Empenhados' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[empenhado_total] > 0)
		formatString: 0
		displayFolder: 1. Estoque

	measure 'SKUs com Disponível' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[estoque_disponivel] > 0)
		formatString: 0
		displayFolder: 1. Estoque

	measure 'SKUs Zerados' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[status_estoque] = "ZERADO")
		formatString: 0
		displayFolder: 1. Estoque

	measure 'SKUs em Risco Estoque' = CALCULATE(DISTINCTCOUNT(fato_estoque_atual[sku_id]), fato_estoque_atual[sku_ativo] = TRUE(), fato_estoque_atual[status_estoque] IN {"BAIXO", "SALDO_COMPROMETIDO"})
		formatString: 0
		displayFolder: 1. Estoque

	measure '% SKUs com Saldo' = DIVIDE([SKUs com Saldo], [SKUs Ativos])
		formatString: 0.0%
		displayFolder: 1. Estoque

	measure 'Estoque Atual (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_estoque_atual[estoque_atual]))
		formatString: #,0.###
		displayFolder: 1. Estoque\Quantidades por U.M.

	measure 'Empenhado Total (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_estoque_atual[empenhado_total]))
		formatString: #,0.###
		displayFolder: 1. Estoque\Quantidades por U.M.

	measure 'Estoque Disponível (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_estoque_atual[estoque_disponivel]))
		formatString: #,0.###
		displayFolder: 1. Estoque\Quantidades por U.M.

	measure 'Entradas (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), CALCULATE(SUM(fato_movimentacoes_estoque[quantidade]), fato_movimentacoes_estoque[tipo] = "ENTRADA", fato_movimentacoes_estoque[movement_status] = "ATIVA"))
		formatString: #,0.###
		displayFolder: 1. Estoque\Quantidades por U.M.

	measure 'Consumo (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), ABS(CALCULATE(SUM(fato_movimentacoes_estoque[quantidade]), fato_movimentacoes_estoque[tipo] = "BAIXA", fato_movimentacoes_estoque[movement_status] = "ATIVA")))
		formatString: #,0.###
		displayFolder: 1. Estoque\Quantidades por U.M.

	measure 'Movimentações Ativas' = CALCULATE(COUNTROWS(fato_movimentacoes_estoque), fato_movimentacoes_estoque[movement_status] = "ATIVA")
		formatString: 0
		displayFolder: 1. Estoque

	measure 'Baixas Registradas' = CALCULATE(COUNTROWS(fato_movimentacoes_estoque), fato_movimentacoes_estoque[movement_status] = "ATIVA", fato_movimentacoes_estoque[tipo] = "BAIXA")
		formatString: 0
		displayFolder: 1. Estoque

	measure 'Status Estoque Ação' = VAR _ativo = SELECTEDVALUE(fato_estoque_atual[sku_ativo]) VAR _status = SELECTEDVALUE(fato_estoque_atual[status_estoque]) RETURN IF(NOT _ativo || _status = "OK", BLANK(), SWITCH(_status, "ZERADO", "REPOR — ZERADO", "SALDO_COMPROMETIDO", "CRÍTICO — COMPROMETIDO", "BAIXO", "REPOR — ABAIXO DO MÍNIMO", _status))
		displayFolder: 1. Estoque\Ações

	measure 'O.S. no WIP' = CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[em_wip] = TRUE())
		formatString: 0
		displayFolder: 2. PCP

	measure 'O.S. em Produção' = CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[fase_wip] = "PRODUCAO")
		formatString: 0
		displayFolder: 2. PCP

	measure 'O.S. Atrasadas' = CALCULATE(DISTINCTCOUNT(dim_ordem_servico[work_order_id]), dim_ordem_servico[entrega_atrasada] = TRUE())
		formatString: 0
		displayFolder: 2. PCP

	measure '% O.S. Atrasadas' = DIVIDE([O.S. Atrasadas], [O.S. no WIP])
		formatString: 0.0%
		displayFolder: 2. PCP

	measure 'Avanço Médio %' = AVERAGEX(FILTER(dim_ordem_servico, dim_ordem_servico[em_wip] = TRUE()), dim_ordem_servico[percentual_avanco]) / 100
		formatString: 0.0%
		displayFolder: 2. PCP

	measure 'Mediana Dias no WIP' = MEDIANX(FILTER(dim_ordem_servico, dim_ordem_servico[em_wip] = TRUE()), dim_ordem_servico[dias_no_wip])
		formatString: 0
		displayFolder: 2. PCP

	measure 'O.S. com Material Pendente' = CALCULATE(DISTINCTCOUNT(fato_necessidades_os[work_order_id]), fato_necessidades_os[quantidade_pendente] > 0)
		formatString: 0
		displayFolder: 2. PCP

	measure 'O.S. com Estrutura' = DISTINCTCOUNT(fato_necessidades_os[work_order_id])
		formatString: 0
		displayFolder: 2. PCP

	measure 'O.S. Totalmente Cobertas' = COUNTROWS(FILTER(VALUES(fato_necessidades_os[work_order_id]), CALCULATE(SUM(fato_necessidades_os[quantidade_pendente])) = 0))
		formatString: 0
		displayFolder: 2. PCP

	measure '% O.S. Cobertas' = DIVIDE([O.S. Totalmente Cobertas], [O.S. com Estrutura])
		formatString: 0.0%
		displayFolder: 2. PCP

	measure 'Linhas Material Pendente O.S.' = CALCULATE(COUNTROWS(fato_necessidades_os), fato_necessidades_os[quantidade_pendente] > 0)
		formatString: 0
		displayFolder: 2. PCP\Ações

	measure 'Dias para Entrega O.S.' = VAR _data = MIN(dim_ordem_servico[data_entrega_vigente]) RETURN IF(NOT ISBLANK(_data), DATEDIFF(TODAY(), _data, DAY))
		formatString: 0
		displayFolder: 2. PCP\Ações

	measure 'Risco O.S.' = VAR _wip = SELECTEDVALUE(dim_ordem_servico[em_wip], FALSE()) VAR _atrasada = SELECTEDVALUE(dim_ordem_servico[entrega_atrasada], FALSE()) VAR _pendente = [Linhas Material Pendente O.S.] RETURN IF(NOT _wip, BLANK(), SWITCH(TRUE(), _atrasada && _pendente > 0, "CRÍTICO — ATRASO + MATERIAL", _atrasada, "CRÍTICO — PRAZO", _pendente > 0, "ATENÇÃO — MATERIAL", "MONITORAR"))
		displayFolder: 2. PCP\Ações

	measure 'Forecasts Ativos' = CALCULATE(DISTINCTCOUNT(fato_forecast[forecast_id]), fato_forecast[status] = "ATIVO")
		formatString: 0
		displayFolder: 2. PCP

	measure 'Linhas em Trânsito' = CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE())
		formatString: 0
		displayFolder: 3. Compras

	measure 'Valor em Trânsito' = CALCULATE(SUM(fato_compras_transito[valor_pendente]), fato_compras_transito[em_transito] = TRUE())
		formatString: R$ #,0.00
		displayFolder: 3. Compras

	measure 'Linhas Atrasadas' = CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE(), FILTER(fato_compras_transito, NOT ISBLANK(fato_compras_transito[data_necessidade]) && fato_compras_transito[data_necessidade] >= DATE(2000, 1, 1) && fato_compras_transito[data_necessidade] < TODAY()))
		formatString: 0
		displayFolder: 3. Compras

	measure '% Linhas Atrasadas' = DIVIDE([Linhas Atrasadas], [Linhas em Trânsito])
		formatString: 0.0%
		displayFolder: 3. Compras

	measure 'Linhas sem Data' = CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE(), fato_compras_transito[situacao_transito] = "SEM DATA")
		formatString: 0
		displayFolder: 3. Compras

	measure 'Linhas Data Inválida' = CALCULATE(COUNTROWS(fato_compras_transito), fato_compras_transito[em_transito] = TRUE(), fato_compras_transito[dias_para_remessa] < -3650)
		formatString: 0
		displayFolder: 3. Compras

	measure 'O.C. Abertas' = CALCULATE(DISTINCTCOUNT(fato_compras_transito[purchase_order_id]), fato_compras_transito[em_transito] = TRUE())
		formatString: 0
		displayFolder: 3. Compras

	measure 'O.C. Atrasadas' = CALCULATE(DISTINCTCOUNT(fato_compras_transito[purchase_order_id]), fato_compras_transito[em_transito] = TRUE(), FILTER(fato_compras_transito, NOT ISBLANK(fato_compras_transito[data_necessidade]) && fato_compras_transito[data_necessidade] >= DATE(2000, 1, 1) && fato_compras_transito[data_necessidade] < TODAY()))
		formatString: 0
		displayFolder: 3. Compras

	measure 'Recebimentos Confirmados' = CALCULATE(COUNTROWS(fato_recebimentos_inspecao), fato_recebimentos_inspecao[status_recebimento] = "CONFIRMADO")
		formatString: 0
		displayFolder: 3. Compras

	measure 'Taxa Aprovação Média %' = AVERAGEX(FILTER(fato_recebimentos_inspecao, fato_recebimentos_inspecao[status_recebimento] = "CONFIRMADO" && fato_recebimentos_inspecao[quantidade_fisica] > 0), DIVIDE(fato_recebimentos_inspecao[quantidade_aprovada], fato_recebimentos_inspecao[quantidade_fisica]))
		formatString: 0.0%
		displayFolder: 3. Compras

	measure 'Ação Compra' = VAR _transito = SELECTEDVALUE(fato_compras_transito[em_transito], FALSE()) VAR _data = SELECTEDVALUE(fato_compras_transito[data_necessidade]) VAR _dias = SELECTEDVALUE(fato_compras_transito[dias_para_remessa]) RETURN IF(NOT _transito, BLANK(), SWITCH(TRUE(), _dias < -3650, "VALIDAR DATA — INVÁLIDA", ISBLANK(_data), "DEFINIR DATA", _data < TODAY(), "COBRAR — ATRASADA", BLANK()))
		displayFolder: 3. Compras\Ações

	measure 'Dias para Remessa Válido' = VAR _dias = SELECTEDVALUE(fato_compras_transito[dias_para_remessa]) RETURN IF(NOT ISBLANK(_dias) && _dias >= -3650, _dias)
		formatString: 0
		displayFolder: 3. Compras\Ações

	measure 'Valor Linha em Trânsito' = IF(SELECTEDVALUE(fato_compras_transito[em_transito], FALSE()), SUM(fato_compras_transito[valor_pendente]))
		formatString: R$ #,0.00
		displayFolder: 3. Compras\Ações

	measure 'SKUs com Demanda' = CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[necessidade_total] > 0)
		formatString: 0
		displayFolder: 4. MRP

	measure 'SKUs MRP em Demanda' = CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[necessidade_total] > 0)
		formatString: 0
		displayFolder: 4. MRP

	measure 'SKUs Cobertos' = CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[necessidade_total] > 0, fato_mrp[status_mrp] = "COBERTO")
		formatString: 0
		displayFolder: 4. MRP

	measure 'SKUs a Comprar' = CALCULATE(DISTINCTCOUNT(fato_mrp[sku_id]), fato_mrp[status_mrp] = "COMPRAR")
		formatString: 0
		displayFolder: 4. MRP

	measure '% SKUs MRP Cobertos' = DIVIDE([SKUs Cobertos], [SKUs com Demanda])
		formatString: 0.0%
		displayFolder: 4. MRP

	measure 'Forecasts sem Estrutura' = CALCULATE(DISTINCTCOUNT(fato_forecast[forecast_id]), fato_forecast[status] = "ATIVO", fato_forecast[possui_estrutura_materiais] = FALSE())
		formatString: 0
		displayFolder: 4. MRP

	measure 'Próxima Necessidade' = CALCULATE(MIN(fato_necessidades_os[data_entrega_vigente]), fato_necessidades_os[quantidade_pendente] > 0)
		formatString: dd/MM/yyyy
		displayFolder: 4. MRP\Ações

	measure 'Dias até Próxima Necessidade' = VAR _data = [Próxima Necessidade] RETURN IF(NOT ISBLANK(_data), DATEDIFF(TODAY(), _data, DAY))
		formatString: 0
		displayFolder: 4. MRP\Ações

	measure 'Prioridade MRP' = VAR _comprar = SELECTEDVALUE(fato_mrp[status_mrp]) = "COMPRAR" VAR _data = [Próxima Necessidade] RETURN IF(NOT _comprar, BLANK(), SWITCH(TRUE(), ISBLANK(_data), "ATENÇÃO — SEM PRAZO", _data <= TODAY(), "CRÍTICO — VENCIDO/HOJE", _data <= TODAY() + 7, "URGENTE — PRÓXIMOS 7 DIAS", "ATENÇÃO — PROGRAMAR"))
		displayFolder: 4. MRP\Ações

	measure 'Ordem Prioridade MRP' = SWITCH(TRUE(), LEFT([Prioridade MRP], 7) = "CRÍTICO", 1, LEFT([Prioridade MRP], 7) = "URGENTE", 2, LEFT([Prioridade MRP], 7) = "ATENÇÃO", 3)
		formatString: 0
		displayFolder: 4. MRP\Ações

	measure 'SKUs Críticos' = COUNTROWS(FILTER(VALUES(dim_sku[sku_id]), VAR _data = CALCULATE(MIN(fato_necessidades_os[data_entrega_vigente]), fato_necessidades_os[quantidade_pendente] > 0) RETURN CALCULATE(MAX(fato_mrp[status_mrp])) = "COMPRAR" && NOT ISBLANK(_data) && _data <= TODAY()))
		formatString: 0
		displayFolder: 4. MRP

	measure 'SKUs Urgentes' = COUNTROWS(FILTER(VALUES(dim_sku[sku_id]), VAR _data = CALCULATE(MIN(fato_necessidades_os[data_entrega_vigente]), fato_necessidades_os[quantidade_pendente] > 0) RETURN CALCULATE(MAX(fato_mrp[status_mrp])) = "COMPRAR" && _data > TODAY() && _data <= TODAY() + 7))
		formatString: 0
		displayFolder: 4. MRP

	measure 'O.S. Impactadas por Compra' = VAR _skuComprar = CALCULATETABLE(VALUES(fato_mrp[sku_id]), fato_mrp[status_mrp] = "COMPRAR") RETURN CALCULATE(DISTINCTCOUNT(fato_necessidades_os[work_order_id]), fato_necessidades_os[quantidade_pendente] > 0, TREATAS(_skuComprar, fato_necessidades_os[sku_id]))
		formatString: 0
		displayFolder: 4. MRP

	measure 'O.S. Impactadas pelo SKU' = CALCULATE(DISTINCTCOUNT(fato_necessidades_os[work_order_id]), fato_necessidades_os[quantidade_pendente] > 0)
		formatString: 0
		displayFolder: 4. MRP\Ações

	measure 'Necessidade Total (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[necessidade_total]))
		formatString: #,0.###
		displayFolder: 4. MRP\Quantidades por U.M.

	measure 'Em Trânsito (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[quantidade_transito]))
		formatString: #,0.###
		displayFolder: 4. MRP\Quantidades por U.M.

	measure 'Estoque Disponível MRP (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[estoque_disponivel]))
		formatString: #,0.###
		displayFolder: 4. MRP\Quantidades por U.M.

	measure 'Necessidade Compra (U.M.)' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[necessidade_compra]))
		formatString: #,0.###
		displayFolder: 4. MRP\Quantidades por U.M.

	measure 'Última Atualização' = MAX(fato_mrp[atualizado_em])
		formatString: dd/MM/yyyy HH:mm
		displayFolder: 5. Auditoria

	measure 'Estoque Atual' = [Estoque Atual (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Empenhado Total' = [Empenhado Total (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Estoque Disponivel' = [Estoque Disponível (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Entradas' = [Entradas (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Consumo' = [Consumo (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Necessidade Total' = [Necessidade Total (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Em Transito' = [Em Trânsito (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'MRP Estoque Disponivel' = [Estoque Disponível MRP (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Necessidade de Compra' = [Necessidade Compra (U.M.)]
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Necessidade de Compra c/ Minimo' = IF(HASONEVALUE(dim_sku[unidade]), SUM(fato_mrp[necessidade_compra_com_estoque_minimo]))
		formatString: #,0.###
		displayFolder: 9. Compatibilidade\Somente U.M. única

	measure 'Avanco Medio %' = [Avanço Médio %]
		formatString: 0.0%
		displayFolder: 9. Compatibilidade

	measure 'O.S. em Producao' = [O.S. em Produção]
		formatString: 0
		displayFolder: 9. Compatibilidade

	measure 'Linhas em Transito' = [Linhas em Trânsito]
		formatString: 0
		displayFolder: 9. Compatibilidade

	measure 'Valor em Transito' = [Valor em Trânsito]
		formatString: R$ #,0.00
		displayFolder: 9. Compatibilidade

	measure 'Taxa Aprovacao %' = [Taxa Aprovação Média %]
		formatString: 0.0%
		displayFolder: 9. Compatibilidade

	measure 'Ultima Atualizacao' = [Última Atualização]
		formatString: dd/MM/yyyy HH:mm
		displayFolder: 9. Compatibilidade

	column sku_id
		dataType: int64
		lineageTag: 322f32fd-b814-4a7e-8c2c-76616994b308
		summarizeBy: none
		sourceColumn: sku_id

