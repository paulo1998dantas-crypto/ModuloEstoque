	column forecast_preditivo_ponderado
		dataType: double
		lineageTag: f9a1171c-0621-4d9b-940b-a00e6df7c556
		summarizeBy: none
		sourceColumn: forecast_preditivo_ponderado

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column necessidade_total
		dataType: double
