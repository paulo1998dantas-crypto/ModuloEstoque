		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column estoque_disponivel
		dataType: double
		lineageTag: 0efca521-cba5-4c03-be6b-42818cf618fc
		summarizeBy: none
		sourceColumn: estoque_disponivel

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

