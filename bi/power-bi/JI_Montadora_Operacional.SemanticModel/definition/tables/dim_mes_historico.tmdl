				    Fonte = PostgreSQL.Database("db.rodtxswtqbsbtukmvobn.supabase.co:5432", "postgres", [CreateNavigationProperties = false]),
				    Dados = Fonte{[Schema = "bi", Item = "dim_mes_historico"]}[Data]
