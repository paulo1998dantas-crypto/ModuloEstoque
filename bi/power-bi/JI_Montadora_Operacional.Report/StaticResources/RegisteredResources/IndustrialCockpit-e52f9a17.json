{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "IndustrialCockpit-e52f9a17.json",
  "dataColors": [
    "#1D4ED8",
    "#0F766E",
    "#2E7D5B",
    "#C6841A",
    "#C2413A",
    "#475467",
    "#7C3AED",
    "#0369A1"
  ],
  "good": "#2E7D5B",
  "neutral": "#C6841A",
  "bad": "#C2413A",
  "maximum": "#1D4ED8",
  "center": "#C6841A",
  "minimum": "#DCE7FF",
  "null": "#98A2B3",
  "foreground": "#17212B",
  "foregroundNeutralSecondary": "#667085",
  "foregroundNeutralTertiary": "#98A2B3",
  "background": "#FFFFFF",
  "backgroundLight": "#EEF2F7",
  "backgroundNeutral": "#F4F6F9",
  "tableAccent": "#1D4ED8",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#17212B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#17212B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#17212B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#344054"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#17212B"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8DEE8"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "value": [
          {
            "bold": true,
            "fontSize": 20,
            "$id": "default"
          }
        ],
        "label": [
          {
            "show": true,
            "fontSize": 10,
            "$id": "default"
          }
        ],
        "cardCalloutArea": [
          {
            "paddingUniform": 6
          }
        ],
        "spacing": [
          {
            "verticalSpacing": 0,
            "$id": "default"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#EEF2F7"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#17212B"
              }
            }
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#17212B"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#17212B"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "legend": [
          {
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#667085"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E7EBF1"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#344054"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#344054"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#17212B"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ]
      }
    }
  }
}