ESTOQUE_DATABASE_MODE=online
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
ESTOQUE_DB_SSLMODE=require
ERP_FEATURE_FLAG=false
ERP_BACKEND_TOKEN=troque-por-token-entre-servicos
# Login central do Portal Operacional. Deixe desligado durante a publicação do
# código; ative apenas quando o Portal responder /healthz com sucesso.
ERP_PORTAL_SSO_ENABLED=0
ERP_PORTAL_URL=https://ji-portal-operacional.onrender.com
ERP_PORTAL_SSO_SECRET=troque-por-um-segredo-compartilhado-aleatorio
